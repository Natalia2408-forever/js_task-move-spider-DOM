"use strict";
document.addEventListener("click", function(e) {
    var spider = document.querySelector(".spider");
    var wall = e.target.closest(".wall");
    if (!wall) return;
    var rect = wall.getBoundingClientRect();
    var newLeft = e.clientX - rect.left - spider.clientWidth / 2;
    var newTop = e.clientY - rect.top - spider.clientHeight / 2;
    newLeft = Math.max(0, Math.min(newLeft, wall.clientWidth - spider.clientWidth));
    newTop = Math.max(0, Math.min(newTop, wall.clientHeight - spider.clientHeight));
    spider.style.top = "".concat(newTop, "px");
    spider.style.left = "".concat(newLeft, "px");
});

